<div class="mx-auto max-w-md px-4 py-14 sm:px-6 md:py-20">
  <p class="eyebrow">Account</p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink">Settings</h1>

  <div class="card mt-8 p-6">
    <h3 class="text-lg font-semibold tracking-tight text-ink">Change email</h3>

    <.form let={f} for={@email_changeset} action={Routes.user_settings_path(@conn, :update)} id="update_email" class="mt-6 space-y-6">
      <%= if @email_changeset.action do %>
        <div class="rounded-xl border border-red-900/60 bg-red-950/40 px-4 py-3 text-sm text-red-200" role="alert">
          <p>Oops, something went wrong! Please check the errors below.</p>
        </div>
      <% end %>

      <%= hidden_input f, :action, name: "action", value: "update_email" %>

      <div>
        <%= label f, :email, class: "mb-2 block text-sm font-medium text-ink-dim" %>
        <%= email_input f, :email, required: true, class: "block w-full rounded-lg border-line bg-surface text-ink shadow-sm placeholder:text-ink-faint focus:border-ink-faint focus:ring-0" %>
        <%= error_tag f, :email %>
      </div>

      <div>
        <%= label f, :current_password, for: "current_password_for_email", class: "mb-2 block text-sm font-medium text-ink-dim" %>
        <%= password_input f, :current_password, required: true, name: "current_password", id: "current_password_for_email", class: "block w-full rounded-lg border-line bg-surface text-ink shadow-sm placeholder:text-ink-faint focus:border-ink-faint focus:ring-0" %>
        <%= error_tag f, :current_password %>
      </div>

      <div>
        <%= submit "Change email", class: "btn-primary" %>
      </div>
    </.form>
  </div>

  <div class="card mt-6 p-6">
    <h3 class="text-lg font-semibold tracking-tight text-ink">Change password</h3>

    <.form let={f} for={@password_changeset} action={Routes.user_settings_path(@conn, :update)} id="update_password" class="mt-6 space-y-6">
      <%= if @password_changeset.action do %>
        <div class="rounded-xl border border-red-900/60 bg-red-950/40 px-4 py-3 text-sm text-red-200" role="alert">
          <p>Oops, something went wrong! Please check the errors below.</p>
        </div>
      <% end %>

      <%= hidden_input f, :action, name: "action", value: "update_password" %>

      <div>
        <%= label f, :password, "New password", class: "mb-2 block text-sm font-medium text-ink-dim" %>
        <%= password_input f, :password, required: true, class: "block w-full rounded-lg border-line bg-surface text-ink shadow-sm placeholder:text-ink-faint focus:border-ink-faint focus:ring-0" %>
        <%= error_tag f, :password %>
      </div>

      <div>
        <%= label f, :password_confirmation, "Confirm new password", class: "mb-2 block text-sm font-medium text-ink-dim" %>
        <%= password_input f, :password_confirmation, required: true, class: "block w-full rounded-lg border-line bg-surface text-ink shadow-sm placeholder:text-ink-faint focus:border-ink-faint focus:ring-0" %>
        <%= error_tag f, :password_confirmation %>
      </div>

      <div>
        <%= label f, :current_password, for: "current_password_for_password", class: "mb-2 block text-sm font-medium text-ink-dim" %>
        <%= password_input f, :current_password, required: true, name: "current_password", id: "current_password_for_password", class: "block w-full rounded-lg border-line bg-surface text-ink shadow-sm placeholder:text-ink-faint focus:border-ink-faint focus:ring-0" %>
        <%= error_tag f, :current_password %>
      </div>

      <div>
        <%= submit "Change password", class: "btn-primary" %>
      </div>
    </.form>
  </div>
</div>

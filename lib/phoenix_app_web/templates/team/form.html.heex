<% label_class = "mb-2 block text-sm font-medium text-ink-dim" %>
<% input_class = "block w-full rounded-lg border-line bg-surface text-ink shadow-sm placeholder:text-ink-faint focus:border-ink-faint focus:ring-0" %>
<.form let={f} for={@changeset} action={@action} class="space-y-6">
  <%= if @changeset.action do %>
    <div class="rounded-xl border border-red-900/60 bg-red-950/40 px-4 py-3 text-sm text-red-200" role="alert">
      <p>Oops, something went wrong! Please check the errors below.</p>
    </div>
  <% end %>

  <div>
    <%= label f, :name, class: label_class %>
    <%= text_input f, :name, class: input_class %>
    <%= error_tag f, :name %>
  </div>

  <div>
    <%= label f, :description, class: label_class %>
    <%= textarea f, :description, rows: 5, class: input_class %>
    <%= error_tag f, :description %>
  </div>

  <div>
    <%= label f, :homepage, class: label_class %>
    <%= text_input f, :homepage, class: input_class %>
    <%= error_tag f, :homepage %>
  </div>

  <div>
    <%= label f, :lang, class: label_class %>
    <%= text_input f, :lang, class: input_class %>
    <%= error_tag f, :lang %>
  </div>

  <div>
    <%= label f, :lang_set, class: label_class %>
    <%= text_input f, :lang_set, class: input_class %>
    <%= error_tag f, :lang_set %>
  </div>

  <div>
    <%= label f, :milestone, class: label_class %>
    <%= number_input f, :milestone, class: input_class %>
    <%= error_tag f, :milestone %>
  </div>

  <div class="pt-2">
    <%= submit "Save", class: "btn-primary" %>
  </div>
</.form>

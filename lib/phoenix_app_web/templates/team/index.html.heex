<%!-- Page header --%>
<section class="relative overflow-hidden">
  <div class="glow-top pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-3xl px-4 pb-10 pt-16 text-center sm:px-6 md:pb-14 md:pt-24">
    <p class="eyebrow">Clients</p>
    <h1 class="mt-4 text-balance text-4xl font-semibold tracking-tight text-ink md:text-5xl">Client implementations</h1>
    <p class="mx-auto mt-5 max-w-xl text-balance leading-relaxed text-ink-mute">
      Client diversity is important for a robust network.
      Having multiple independent implementations makes
      it less likely for a large portion of the network to be affected
      by the same bug.
    </p>
    <div class="mt-8">
      <%= link to: "https://github.com/w3f-webops/graypaper-website/issues/new?assignees=&labels=&projects=&template=client-listing-request.md&title=Client+Listing%3A+XYZ", target: "_blank", rel: "noopener noreferrer", class: "btn-primary" do %>
        Get Listed <span aria-hidden="true">&#8599;</span>
      <% end %>
    </div>
  </div>
</section>

<section class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
  <%!-- Stats --%>
  <div class="card grid grid-cols-1 divide-y divide-line overflow-hidden sm:grid-cols-2 sm:divide-x sm:divide-y-0">
    <div class="px-8 py-8 text-center">
      <p class="font-mono text-4xl font-semibold tracking-tight text-ink"><%= length(@teams) %></p>
      <p class="eyebrow mt-3">Total teams</p>
    </div>
    <div class="px-8 py-8 text-center">
      <p class="font-mono text-4xl font-semibold tracking-tight text-ink"><%= @teams |> Enum.map(&(&1.lang)) |> Enum.uniq() |> length() %></p>
      <p class="eyebrow mt-3">Programming languages</p>
    </div>
  </div>

  <%!-- Teams table --%>
  <div class="card mt-6 overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="border-b border-line">
          <th class="px-6 py-4 text-left font-normal">
            <%= link to: Routes.team_path(@conn, :index, sort: "name", order: sort_order("name", @sort_by, @sort_order)), class: "group inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider text-ink-faint transition-colors hover:text-ink-mute" do %>
              <span>Team Name</span>
              <%= if @sort_by == "name" do %>
                <%= if @sort_order == "asc" do %>
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
                <% else %>
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                <% end %>
              <% else %>
                <svg class="h-3.5 w-3.5 opacity-0 group-hover:opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
              <% end %>
            <% end %>
          </th>
          <th class="px-6 py-4 text-left font-normal">
            <%= link to: Routes.team_path(@conn, :index, sort: "lang", order: sort_order("lang", @sort_by, @sort_order)), class: "group inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider text-ink-faint transition-colors hover:text-ink-mute" do %>
              <span>Language</span>
              <%= if @sort_by == "lang" do %>
                <%= if @sort_order == "asc" do %>
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
                <% else %>
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                <% end %>
              <% else %>
                <svg class="h-3.5 w-3.5 opacity-0 group-hover:opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
              <% end %>
            <% end %>
          </th>
          <th class="px-6 py-4 text-left font-normal">
            <%= link to: Routes.team_path(@conn, :index, sort: "lang_set", order: sort_order("lang_set", @sort_by, @sort_order)), class: "group inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider text-ink-faint transition-colors hover:text-ink-mute" do %>
              <span>Language Set</span>
              <%= if @sort_by == "lang_set" do %>
                <%= if @sort_order == "asc" do %>
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
                <% else %>
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                <% end %>
              <% else %>
                <svg class="h-3.5 w-3.5 opacity-0 group-hover:opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
              <% end %>
            <% end %>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <%= for team <- @teams do %>
          <tr class="group transition-colors hover:bg-surface-2/40">
            <td class="p-0">
              <div class="flex items-center gap-2 px-6 py-4">
                <%= link team.name, to: Routes.team_path(@conn, :show, team), class: "font-medium text-ink-dim transition-colors group-hover:text-ink" %>
                <%= if not is_nil(team.homepage) and team.homepage != "" do %>
                  <a href={team.homepage} target="_blank" rel="noopener noreferrer" class="text-ink-faint transition-colors hover:text-ink" aria-label={"#{team.name} homepage"}>&#8599;</a>
                <% end %>
              </div>
            </td>
            <td class="p-0">
              <%= link to: Routes.team_path(@conn, :show, team), class: "block px-6 py-4 font-mono text-xs text-ink-mute", tabindex: "-1" do %><%= team.lang %><% end %>
            </td>
            <td class="p-0">
              <%= link to: Routes.team_path(@conn, :show, team), class: "block px-6 py-4 font-mono text-xs text-ink-mute", tabindex: "-1" do %><%= team.lang_set %><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= if PhoenixAppWeb.UserAuth.authenticated?(@conn) do %>
    <div class="mt-6">
      <%= link "New Team", to: Routes.team_path(@conn, :new), class: "btn-ghost" %>
    </div>
  <% end %>
</section>

<section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 md:py-20">
  <p class="eyebrow">Client</p>
  <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink">
    <%= @team.name %>
    <%= if not is_nil(@team.homepage) and @team.homepage != "" do %>
      <a href={@team.homepage} class="align-middle text-xl text-ink-faint transition-colors hover:text-ink" target="_blank" rel="noopener noreferrer" aria-label={"#{@team.name} homepage"}>&#8599;</a>
    <% end %>
  </h1>
  <p class="mt-2 font-mono text-sm text-ink-faint"><%= @team.lang %> &middot; set <%= @team.lang_set %></p>

  <div class="card mt-8 p-6 md:p-8">
    <ul class="space-y-4">
      <%= if not is_nil(@team.description) and String.length(@team.description) > 0 do %>
        <li class="leading-relaxed text-ink-dim">
          <%= @team.description %>
        </li>
      <% end %>
      <%= if length(@team.contact) > 0 do %>
        <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="eyebrow">Contact</span>
          <code class="font-mono text-sm text-ink-mute"><%= Enum.join(@team.contact, ", ") %></code>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="mt-10">
    <h2 class="eyebrow mb-4">Milestone progress</h2>
    <div class="flex items-center gap-1.5">
      <%= for i <- 0..4 do %>
        <div class={"
          #{if i <= @team.milestone, do: "bg-ink text-bg", else: "border border-line text-ink-faint"}
          #{if i == @team.milestone, do: "animate-pulse", else: ""}
          flex h-9 flex-1 items-center justify-center overflow-hidden whitespace-nowrap rounded-lg font-mono text-xs transition duration-500
        "} role="progressbar" aria-valuenow={@team.milestone + 1} aria-valuemin="1" aria-valuemax="5" aria-label={"Milestone #{i + 1}"}>M<%= i + 1 %></div>
      <% end %>
    </div>
  </div>

  <div class="mt-10 flex items-center gap-4">
    <%= if PhoenixAppWeb.UserAuth.authenticated?(@conn) do %>
      <%= link "Edit", to: Routes.team_path(@conn, :edit, @team), class: "btn-primary" %>
    <% end %>
    <%= link "Back", to: Routes.team_path(@conn, :index), class: "btn-ghost" %>
  </div>
</section>

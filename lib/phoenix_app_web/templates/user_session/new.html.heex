<div class="mx-auto max-w-md px-4 py-14 sm:px-6 md:py-20">
  <p class="eyebrow">Account</p>
  <h1 class="mb-8 mt-3 text-3xl font-semibold tracking-tight text-ink">Log in</h1>

  <.form :let={f} for={@conn} action={Routes.user_session_path(@conn, :create)} as={:user} class="space-y-6">
    <%= if @error_message do %>
      <div class="rounded-xl border border-red-900/60 bg-red-950/40 px-4 py-3 text-sm text-red-200" role="alert">
        <p><%= @error_message %></p>
      </div>
    <% end %>

    <div>
      <%= label f, :email, class: "mb-2 block text-sm font-medium text-ink-dim" %>
      <%= email_input f, :email, required: true, class: "block w-full rounded-lg border-line bg-surface text-ink shadow-sm placeholder:text-ink-faint focus:border-ink-faint focus:ring-0" %>
    </div>

    <div>
      <%= label f, :password, class: "mb-2 block text-sm font-medium text-ink-dim" %>
      <%= password_input f, :password, required: true, class: "block w-full rounded-lg border-line bg-surface text-ink shadow-sm placeholder:text-ink-faint focus:border-ink-faint focus:ring-0" %>
    </div>

    <div class="flex items-center gap-2">
      <%= checkbox f, :remember_me, class: "h-4 w-4 rounded border-line-strong bg-surface text-ink focus:ring-0 focus:ring-offset-0" %>
      <%= label f, :remember_me, "Keep me logged in for 60 days", class: "block text-sm text-ink-mute" %>
    </div>

    <div>
      <%= submit "Log in", class: "btn-primary w-full" %>
    </div>
  </.form>

  <p class="mt-6 text-center text-sm text-ink-faint">
    <%= link "Register", to: Routes.user_registration_path(@conn, :new), class: "font-medium text-ink-mute transition-colors hover:text-ink" %>
    &middot;
    <%= link "Forgot your password?", to: Routes.user_reset_password_path(@conn, :new), class: "font-medium text-ink-mute transition-colors hover:text-ink" %>
  </p>
</div>

<%= if @current_user do %>
  <ul class="flex items-center gap-5 text-sm">
    <li class="hidden font-mono text-xs text-ink-faint lg:block"><%= @current_user.email %></li>
    <li><%= link "Settings", to: Routes.user_settings_path(@conn, :edit), class: "text-ink-mute transition-colors hover:text-ink" %></li>
    <li><%= link "Log out", to: Routes.user_session_path(@conn, :delete), method: :delete, class: "text-ink-mute transition-colors hover:text-red-300" %></li>
  </ul>
<% else %>
  <%!-- Register / Log in links intentionally disabled — see user_registration / user_session routes --%>
<% end %>

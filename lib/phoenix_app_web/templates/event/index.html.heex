<%!-- Page header --%>
<section class="relative overflow-hidden">
  <div class="glow-top pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-3xl px-4 pb-10 pt-16 text-center sm:px-6 md:pb-14 md:pt-24">
    <p class="eyebrow">Events</p>
    <h1 class="mt-4 text-balance text-4xl font-semibold tracking-tight text-ink md:text-5xl">Community events</h1>
    <p class="mx-auto mt-5 max-w-xl text-balance leading-relaxed text-ink-mute">
      Join our community organized events 🤝
    </p>
  </div>
</section>

<section class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
  <div class="flex flex-col gap-4">
    <%= for event <- Enum.reject(@events, & &1.historic) do %>
      <%= link to: Routes.event_path(@conn, :show, event), class: "block group" do %>
        <div class="card card-hover gap-6 px-6 py-5 md:flex md:items-baseline md:justify-between">
          <div class="min-w-0">
            <h2 class="text-lg font-semibold tracking-tight text-ink"><%= event.name %></h2>
            <p class="mt-1 text-sm leading-relaxed text-ink-mute"><%= event.short %></p>
          </div>
          <p class="mt-3 shrink-0 font-mono text-xs text-ink-faint md:mt-0 md:text-right">
            <%= event.where %> &middot; <%= fmt_when(event) %>
          </p>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= if Enum.any?(@events, & &1.historic) do %>
    <h2 class="eyebrow mb-6 mt-16">Past events</h2>
    <div class="flex flex-col gap-4">
      <%= for event <- Enum.filter(@events, & &1.historic) do %>
        <%= link to: Routes.event_path(@conn, :show, event), class: "block group opacity-60 transition-opacity hover:opacity-100" do %>
          <div class="card card-hover gap-6 px-6 py-5 md:flex md:items-baseline md:justify-between">
            <div class="min-w-0">
              <h3 class="text-lg font-semibold tracking-tight text-ink"><%= event.name %></h3>
              <p class="mt-1 text-sm leading-relaxed text-ink-mute"><%= event.short %></p>
            </div>
            <p class="mt-3 shrink-0 font-mono text-xs text-ink-faint md:mt-0 md:text-right">
              <%= event.where %> &middot; <%= fmt_when(event) %>
            </p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>

<%!-- Event header --%>
<section class="relative overflow-hidden">
  <div class="glow-top pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-5xl px-4 pb-10 pt-16 sm:px-6 md:pb-12 md:pt-20">
    <p class="eyebrow">Event</p>
    <h1 class="mt-4 text-balance text-4xl font-semibold tracking-tight text-ink md:text-5xl"><%= @event.name %></h1>
    <%= if @event.short do %>
      <p class="mt-5 max-w-2xl text-balance text-lg leading-relaxed text-ink-mute"><%= @event.short %></p>
    <% end %>
  </div>
</section>

<%= if @event.historic do %>
  <div class="w-full border-y border-line bg-surface px-4 py-3">
    <div class="mx-auto flex max-w-5xl items-center justify-center gap-2 text-sm text-ink-mute">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-ink-faint" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
      </svg>
      <p>This event already happened and is shown for archival purposes only.</p>
    </div>
  </div>
<% end %>

<section class="w-full py-10 md:py-14">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <%!-- Main Content --%>
      <div class="space-y-6 md:col-span-2">
        <div class="card p-6 md:p-8">
          <h2 class="text-xl font-semibold tracking-tight text-ink">About this event</h2>
          <div class="rich-text mt-4">
            <%= raw(fmt_desc(@event)) %>
          </div>
        </div>

        <%!-- Contact Information --%>
        <%= if @event.contact && length(@event.contact) > 0 do %>
          <div class="card p-6 md:p-8">
            <h3 class="text-xl font-semibold tracking-tight text-ink">Contact</h3>
            <div class="mt-4 space-y-2">
              <%= for contact <- @event.contact do %>
                <p class="font-mono text-sm text-ink-mute"><%= contact %></p>
              <% end %>
            </div>
          </div>
        <% end %>

        <%= if @event.links && length(@event.links) > 0 do %>
          <div class="card p-6 md:p-8">
            <h3 class="text-xl font-semibold tracking-tight text-ink">Related links</h3>
            <div class="mt-4 space-y-2">
              <%= for {link, index} <- Enum.with_index(@event.links) do %>
                <div class="flex items-baseline gap-3">
                  <span class="min-w-[1.5rem] font-mono text-xs text-ink-faint"><%= index + 1 %></span>
                  <%= link link,
                    to: link,
                    class: "break-all text-sm text-ink-mute underline decoration-stone-600 underline-offset-4 transition-colors hover:text-ink hover:decoration-stone-300",
                    target: "_blank" %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%!-- Sidebar --%>
      <div class="space-y-6">
        <div class="card space-y-5 p-6">
          <%!-- Date Information --%>
          <div class="flex items-start gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-ink-faint" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <div>
              <p class="eyebrow">Date</p>
              <%= if @event.when_from do %>
                <p class="mt-1.5 text-sm text-ink-dim">
                  <%= Calendar.strftime(@event.when_from, "%B %d, %Y") %>
                  <%= if @event.when_to && @event.when_to != @event.when_from do %>
                    &ndash; <%= Calendar.strftime(@event.when_to, "%B %d, %Y") %>
                  <% end %>
                  <%= fmt_duration(@event) %>
                </p>
              <% end %>
              <%= if @event.when_est do %>
                <p class="mt-1.5 text-sm text-ink-mute">
                  <%= @event.when_est %> <%= fmt_duration(@event) %>
                </p>
              <% end %>
            </div>
          </div>

          <%!-- Location --%>
          <div class="flex items-start gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-ink-faint" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div>
              <p class="eyebrow">Location</p>
              <%= if @event.where_link do %>
                <%= link to: @event.where_link, class: "mt-1.5 inline-block text-sm text-ink-dim transition-colors hover:text-ink" do %>
                  <%= @event.where %>
                  <span class="text-ink-faint" aria-hidden="true">&#8599;</span>
                <% end %>
              <% else %>
                <p class="mt-1.5 text-sm text-ink-dim"><%= @event.where %></p>
              <% end %>
            </div>
          </div>
        </div>

        <%!-- Call to Action --%>
        <%= if @event.links && length(@event.links) > 0 do %>
          <%= link to: Enum.at(@event.links, @event.learn_more_id), target: "_blank", rel: "noopener noreferrer", class: "btn-primary w-full" do %>
            Learn more <span aria-hidden="true">&#8599;</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</section>
